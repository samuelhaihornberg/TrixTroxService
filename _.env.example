# Copie ce fichier en ".env" et remplis les valeurs. Ne commit jamais le fichier ".env".

# Identifiants de l'application REST PayPal (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# "live" = vrais paiements (par défaut). "sandbox" = tests.
PAYPAL_ENV=live

# Devise des prix du site
CURRENCY=EUR

# Port du serveur
PORT=3000

# Domaine(s) autorisé(s) à appeler ce backend, séparés par des virgules.
# Exemple : https://tricktrock.com,https://www.tricktrock.com
# Laisser vide si la page est servie par ce serveur lui-même.
ALLOWED_ORIGIN=

# "true" : le serveur sert aussi index.html (pratique en local). "false" : API seule.
SERVE_PAGE=true
